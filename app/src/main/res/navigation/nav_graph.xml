<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.artopiacontrol.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/userListFragment"
        android:name="com.example.artopiacontrol.UserListFragment"
        android:label="Student Management"
        tools:layout="@layout/fragment_user_list" />

    <fragment
        android:id="@+id/activityLogFragment"
        android:name="com.example.artopiacontrol.ActivityLogFragment"
        android:label="Admin Activity" />

    <fragment
        android:id="@+id/userDetailFragment"
        android:name="com.example.artopiacontrol.UserDetailFragment"
        android:label="Account details"
        tools:layout="@layout/fragment_user_detail">
        <argument
            android:name="userId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createAccountFragment"
        android:name="com.example.artopiacontrol.CreateAccountFragment"
        android:label="Account Creation"
        tools:layout="@layout/fragment_create_account" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.artopiacontrol.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

</navigation>