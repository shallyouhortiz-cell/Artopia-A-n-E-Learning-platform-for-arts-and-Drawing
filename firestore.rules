rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Common Authentication Helpers
    function isAuthed() {
      return request.auth != null;
    }

    // =========================================================================
    // 1. USERS COLLECTION & PRIVATE METADATA (/users & /users/{userId}/private/meta)
    // Supports: Login, Signup, Admin Invitation, Profile Editing, Role Checks, Sections
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if true; // Allows new admin/user registration
      allow update: if isAuthed();
      allow delete: if isAuthed();

      match /private/meta {
        allow read: if isAuthed();
        allow create, update, write: if true; // Allows meta doc creation during signup
      }

      match /private/{document=**} {
        allow read, write: if isAuthed();
      }
    }

    // Collection Group Query support for role/meta filtering
    match /{path=**}/private/meta {
      allow read: if isAuthed();
    }

    // =========================================================================
    // 2. ADMIN ACTIVITY AUDIT LOGS (/adminLogs)
    // Supports: Activity Log Fragment & Audit Logging
    // =========================================================================
    match /adminLogs/{logId} {
      allow read: if isAuthed();
      allow create, write: if isAuthed();
    }

    // =========================================================================
    // 3. TRIGGER EMAIL FROM FIRESTORE EXTENSION (/mail)
    // Supports: Triggering Email extension on account creation
    // =========================================================================
    match /mail/{mailId} {
      allow create, write: if true; // Allows sending email trigger during signup
      allow read: if isAuthed();
    }

    // =========================================================================
    // 4. STUDENT ARTWORKS & EVALUATIONS (/artworks & /evaluations)
    // Supports: Section-based artwork checking (Teachers check their section)
    // =========================================================================
    match /artworks/{artworkId} {
      allow read, write: if isAuthed();
    }

    match /evaluations/{evaluationId} {
      allow read, write: if isAuthed();
    }
  }
}
