{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null",
        "presence": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
        }
      }
    },
    "user_profiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "artworks": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        "$artworkId": {
          ".write": "auth != null"
        }
      }
    },
    "evaluations": {
      ".read": "auth != null",
      "$artworkId": {
        ".write": "auth != null"
      }
    },
    "student_progress": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "activity_logs": {
      ".read": "auth != null",
      "$logId": {
        ".write": "auth != null"
      },
      ".indexOn": "timestamp"
    },
    "notifications": {
      ".read": "auth != null",
      "$notificationId": {
        ".write": "auth != null"
      },
      ".indexOn": ["timestamp", "targetRole", "targetUserId"]
    }
  }
}
